<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portofolio - Indri Khoerunnisa | APHP SMKN Bojonggambir</title>
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Font Awesome untuk Ikon -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Google Fonts (Poppins) -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Poppins', sans-serif;
        }
    </style>
</head>
<body class="bg-emerald-50/50 text-slate-800 antialiased selection:bg-emerald-500 selection:text-white">

    <!-- 1. NAVBAR -->
    <nav class="sticky top-0 z-50 bg-white/80 backdrop-blur-md shadow-sm border-b border-emerald-100">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <!-- Brand Name -->
                <a href="#" class="font-bold text-lg sm:text-xl text-emerald-800 tracking-wide flex items-center gap-2">
                    <i class="fa-solid fa-leaf text-emerald-600"></i>
                    <span>Indri Khoerunnisa</span>
                </a>

                <!-- Mobile Menu Button -->
                <button id="menu-btn" class="sm:hidden text-slate-600 hover:text-emerald-600 focus:outline-none p-2 rounded-lg" aria-label="Toggle Navigation">
                    <i class="fa-solid fa-bars text-xl"></i>
                </button>

                <!-- Desktop Navigation Links -->
                <div class="hidden sm:flex space-x-8 font-medium text-slate-600">
                    <a href="#hero" class="hover:text-emerald-600 transition-colors duration-200">Beranda</a>
                    <a href="#skills" class="hover:text-emerald-600 transition-colors duration-200">Keahlian</a>
                    <a href="#proyek" class="hover:text-emerald-600 transition-colors duration-200">Galeri Proyek</a>
                </div>
            </div>

            <!-- Mobile Navigation Menu -->
            <div id="mobile-menu" class="hidden sm:hidden pb-4 pt-2 border-t border-slate-100 space-y-2 font-medium">
                <a href="#hero" class="block px-3 py-2 rounded-md text-slate-600 hover:text-emerald-600 hover:bg-emerald-50 transition">Beranda</a>
                <a href="#skills" class="block px-3 py-2 rounded-md text-slate-600 hover:text-emerald-600 hover:bg-emerald-50 transition">Keahlian</a>
                <a href="#proyek" class="block px-3 py-2 rounded-md text-slate-600 hover:text-emerald-600 hover:bg-emerald-50 transition">Galeri Proyek</a>
            </div>
        </div>
    </nav>

    <!-- 2. HERO SECTION -->
    <section id="hero" class="py-16 md:py-24 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row items-center justify-between gap-10">
            <!-- Profile Text -->
            <div class="text-center md:text-left order-2 md:order-1 flex-1">
                <span class="inline-block px-3 py-1 bg-emerald-100 text-emerald-800 font-semibold text-xs sm:text-sm rounded-full mb-4">
                    Siswa SMKN Bojonggambir
                </span>
                <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-slate-900 leading-tight mb-4">
                    Halo, Saya <span class="text-emerald-600">Indri Khoerunnisa</span>
                </h1>
                <p class="text-slate-600 text-sm sm:text-base leading-relaxed mb-8 max-w-xl mx-auto md:mx-0">
                    Siswa jurusan Agribisnis Pengolahan Hasil Pertanian (APHP). Memiliki minat tinggi dalam inovasi produk pangan, pengolahan hasil tani, dan pemrosesan makanan yang higienis serta berkualitas.
                </p>
                <div>
                    <a href="#proyek" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-emerald-600 hover:bg-emerald-700 text-white font-medium rounded-xl shadow-lg shadow-emerald-600/30 hover:shadow-emerald-600/40 transform hover:-translate-y-0.5 transition duration-200 w-full sm:w-auto">
                        <span>Lihat Karya</span>
                        <i class="fa-solid fa-arrow-right text-sm"></i>
                    </a>
                </div>
            </div>

            <!-- Profile Image -->
            <div class="order-1 md:order-2 flex justify-center">
                <div class="relative">
                    <!-- Decorative Background Ring -->
                    <div class="absolute -inset-1.5 bg-gradient-to-r from-emerald-500 to-teal-400 rounded-full blur opacity-50"></div>
                    <img src="https://ibb.co.com/sdmXyHDR" alt="Foto Profil Indri Khoerunnisa" class="relative w-44 h-44 sm:w-56 sm:h-56 md:w-64 md:h-64 rounded-full object-cover border-4 border-white shadow-xl">
                </div>
            </div>
        </div>
    </section>

    <!-- 3. SKILL SECTION -->
    <section id="skills" class="py-16 bg-white border-y border-emerald-50">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-2xl mx-auto mb-12">
                <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">Keahlian Saya</h2>
                <p class="text-slate-500 text-sm sm:text-base">Kompetensi utama yang saya pelajari dalam jurusan Agribisnis Pengolahan Hasil Pertanian.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
                <!-- Skill 1 -->
                <div class="p-6 rounded-2xl bg-emerald-50/50 border border-emerald-100 hover:border-emerald-300 transition duration-300 hover:shadow-lg hover:shadow-emerald-500/5 group">
                    <div class="w-12 h-12 bg-emerald-600 text-white rounded-xl flex items-center justify-center text-xl mb-5 group-hover:scale-110 transition duration-300">
                        <i class="fa-solid fa-apple-whole"></i>
                    </div>
                    <h3 class="text-lg font-bold text-slate-800 mb-2">Pengolahan Hasil Nabati & Hewani</h3>
                    <p class="text-slate-600 text-sm leading-relaxed">
                        Mampu mengolah komoditas nabati dan hewani menjadi produk pangan olahan bermutu tinggi sesuai standar keamanan pangan.
                    </p>
                </div>

                <!-- Skill 2 -->
                <div class="p-6 rounded-2xl bg-emerald-50/50 border border-emerald-100 hover:border-emerald-300 transition duration-300 hover:shadow-lg hover:shadow-emerald-500/5 group">
                    <div class="w-12 h-12 bg-emerald-600 text-white rounded-xl flex items-center justify-center text-xl mb-5 group-hover:scale-110 transition duration-300">
                        <i class="fa-solid fa-vial-circle-check"></i>
                    </div>
                    <h3 class="text-lg font-bold text-slate-800 mb-2">Pengawasan Mutu Pangan</h3>
                    <p class="text-slate-600 text-sm leading-relaxed">
                        Pengujian organoleptik, fisik, dan kimia sederhana untuk memastikan kualitas produk pangan aman dikonsumsi.
                    </p>
                </div>

                <!-- Skill 3 -->
                <div class="p-6 rounded-2xl bg-emerald-50/50 border border-emerald-100 hover:border-emerald-300 transition duration-300 hover:shadow-lg hover:shadow-emerald-500/5 group">
                    <div class="w-12 h-12 bg-emerald-600 text-white rounded-xl flex items-center justify-center text-xl mb-5 group-hover:scale-110 transition duration-300">
                        <i class="fa-solid fa-box-archive"></i>
                    </div>
                    <h3 class="text-lg font-bold text-slate-800 mb-2">Pengemasan & Penyimpanan</h3>
                    <p class="text-slate-600 text-sm leading-relaxed">
                        Penerapan teknik pengemasan modern dan metode penyimpanan produk pangan untuk memperpanjang daya simpan.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- 4. GALERI PROYEK -->
    <section id="proyek" class="py-16 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-12">
            <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">Galeri Proyek & Tugas</h2>
            <p class="text-slate-500 text-sm sm:text-base">Dokumentasi hasil karya praktikum dan tugas pembelajaran APHP di sekolah.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
            <!-- Card Proyek 1 -->
            <div class="bg-white rounded-2xl overflow-hidden border border-slate-100 shadow-sm hover:shadow-xl transition duration-300 flex flex-col">
                <img src="https://images.unsplash.com/photo-1590080875515-8a3a8dc5735e?auto=format&fit=crop&w=600&q=80" alt="Pembuatan Selai Buah" class="w-full h-48 object-cover">
                <div class="p-6 flex-1 flex flex-col justify-between">
                    <div>
                        <span class="text-xs font-semibold uppercase tracking-wider text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-md">Praktikum Nabati</span>
                        <h3 class="text-lg font-bold text-slate-800 mt-3 mb-2">Pembuatan Selai & Manisan Buah</h3>
                        <p class="text-slate-600 text-sm">Proses ekstraksi, penambahan gula, dan pengukuran tingkat keasaman (pH) hingga tercapai konsistensi terbaik.</p>
                    </div>
                </div>
            </div>

            <!-- Card Proyek 2 -->
            <div class="bg-white rounded-2xl overflow-hidden border border-slate-100 shadow-sm hover:shadow-xl transition duration-300 flex flex-col">
                <img src="https://images.unsplash.com/photo-1528735602780-2552fd46c7af?auto=format&fit=crop&w=600&q=80" alt="Pengolahan Roti dan Bakery" class="w-full h-48 object-cover">
                <div class="p-6 flex-1 flex flex-col justify-between">
                    <div>
                        <span class="text-xs font-semibold uppercase tracking-wider text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-md">Produksi Pengolahan</span>
                        <h3 class="text-lg font-bold text-slate-800 mt-3 mb-2">Inovasi Roti & Produk Bakery</h3>
                        <p class="text-slate-600 text-sm">Penerapan teknik fermentasi, pencetakan adonan, dan panggangan untuk menghasilkan produk bakery standar komersial.</p>
                    </div>
                </div>
            </div>

            <!-- Card Proyek 3 -->
            <div class="bg-white rounded-2xl overflow-hidden border border-slate-100 shadow-sm hover:shadow-xl transition duration-300 flex flex-col">
                <img src="https://images.unsplash.com/photo-1589367920969-ab8e050bbb04?auto=format&fit=crop&w=600&q=80" alt="Pengemasan Produk" class="w-full h-48 object-cover">
                <div class="p-6 flex-1 flex flex-col justify-between">
                    <div>
                        <span class="text-xs font-semibold uppercase tracking-wider text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-md">Pengemasan</span>
                        <h3 class="text-lg font-bold text-slate-800 mt-3 mb-2">Desain Packaging & Labelling</h3>
                        <p class="text-slate-600 text-sm">Pembuatan label informasi nilai gizi serta pemilihan kemasan kedap udara untuk menjaga higienitas produk.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 5. FOOTER -->
    <footer class="bg-slate-900 text-slate-300 py-8 border-t border-slate-800">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
            <p class="text-sm sm:text-base">
                &copy; <span id="year"></span> Indri Khoerunnisa - APHP SMKN Bojonggambir. All rights reserved.
            </p>
            <div>
                <a href="https://ibb.co.com/YB7Dw6g5" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-xs sm:text-sm text-emerald-400 hover:text-emerald-300 underline underline-offset-4 transition">
                    <i class="fa-solid fa-link"></i>
                    <span>https://ibb.co.com/YB7Dw6g5</span>
                </a>
            </div>
        </div>
    </footer>

    <!-- JAVASCRIPT (Interaktivitas Menu Mobile & Tahun Otomatis) -->
    <script>
        // Toggle Navigasi Mobile
        const menuBtn = document.getElementById('menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');

        menuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        // Tutup menu mobile ketika link diklik
        document.querySelectorAll('#mobile-menu a').forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
            });
        });

        // Update tahun copyright otomatis
        document.getElementById('year').textContent = new Date().getFullYear();
    </script>
</body>
</html>
